FREVAGPT_VERSION="0.1.0" # The version of the backend

FREVAGPT_HOST="0.0.0.0"
FREVAGPT_BACKEND_PORT=8502 # The port on which the backend will run, transparent to the outside
FREVAGPT_TARGET_PORT=8502 # The port on which the backend will be accessible from the outside; change this if you want to run multiple instances on the same server

FREVAGPT_INSTANCE_NAME="dev" # The name of the instance, used to differentiate between multiple instances on the same server/filesystem

FREVAGPT_CACHE_PATH=/scratch/climateclaw  # The path where the output of code (if saved by the bot) will be stored.
FREVAGPT_WORKDIR=/climateclaw

FREVAGPT_OPENAI_API_KEY="YOUR_OPENAI_API_KEY" # The OpenAI API key to use for the OpenAI API
FREVAGPT_LITE_LLM_ADDRESS="http://haproxy:4000" # The address of the LiteLLM Proxy

# MCP SETTINGS
FREVAGPT_RAG_PORT=8050
FREVAGPT_CODE_PORT=8051
FREVAGPT_WEB_SEARCH_PORT=8052

FREVAGPT_AVAILABLE_MCP_SERVERS=rag,code,web-search  # The list of servers to connect via backends client
# IMPORTANT: Server URLs must be given as 'FREVAGPT_{server_name}_SERVER_URL' for successful parsing
FREVAGPT_RAG_SERVER_URL="http://haproxy:8050"
FREVAGPT_CODE_SERVER_URL="http://haproxy:8051"
FREVAGPT_WEB_SEARCH_SERVER_URL="http://haproxy:8052"
FREVAGPT_MCP_REQUEST_TIMEOUT_SEC=600

# MONGODB SETTINGS
FREVAGPT_MONGODB_DATABASE_NAME="chatbot" # The name of the MongoDB database to use for the storage of threads
FREVAGPT_MONGODB_COLLECTION_NAME="threads" # The name of the MongoDB collection to use for the storage of threads
FREVAGPT_MONGODB_USER="yourusername"
FREVAGPT_MONGODB_PASSWORD="yourpassword"

FREVAGPT_BACKEND_REPLICAS=1
FREVAGPT_CODE_REPLICAS=1