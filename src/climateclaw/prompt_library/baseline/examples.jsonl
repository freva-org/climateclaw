{"variant":"Code","content":["{\"code\": \"import freva_client\nimport xarray as xr\nimport matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nimport numpy as np\n# Load sea level pressure data (psl) for the year 2023 from ERA5\nfiles = freva_client.databrowser(\n    project='reanalysis', experiment='era5', \n    variable='psl', time_frequency='mon', \n    time='2023-01-01to2023-12-31', host='nextgems.dkrz.de')\ndset = xr.open_mfdataset(list(files), combine='by_coords', data_vars='all')\n# Compute the annual mean sea level pressure\nannual_mean_psl = dset['psl'].mean(dim='time')\n# Convert from Pa to hPa\nannual_mean_psl_hPa = annual_mean_psl/100\n\n# Create a global map plot of the annual mean sea level pressure\nfig, ax = plt.subplots(figsize=(10, 6), \n                       subplot_kw={'projection': ccrs.PlateCarree()})\nax.set_global()\n# Determine contour levels\nvmin = np.nanmin(annual_mean_psl_hPa.values)\nvmax = np.nanmax(annual_mean_psl_hPa.values)\nlevels = np.linspace(vmin, vmax, 20)\n# Plot the data\ncs = ax.contourf(\n    annual_mean_psl_hPa['lon'], annual_mean_psl_hPa['lat'], annual_mean_psl_hPa.values, \n    levels=levels, extend = 'both', cmap='coolwarm', \n    transform=ccrs.PlateCarree())\n# Add coastlines and borders\nax.coastlines()\nax.add_feature(cfeature.BORDERS, linestyle=':')\n# Add a colorbar and title\ncb = plt.colorbar(cs, orientation='horizontal', pad=0.05, aspect=50, label='Sea Level Pressure (hPa)')\nplt.title('Annual Mean Sea Level Pressure for 2023')\n# Save the figure \nplt.savefig('plot.png', bbox_inches='tight', dpi=300)\nplt.close()\" }"]}
