{"variant":"Code","content":["{\"code\":\"import freva_client\nimport xarray as xr\nimport matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nimport numpy as np\n# Define the requested dates\ndates = [f'{y}-06-27' for y in range(2022, 2027)]\n# Query ERA5 daily maximum temperature (tasmax) using freva_client\ntasmax_maps = []\nfor date in dates:\n    files = freva_client.databrowser(\n        project='reanalysis',\n        experiment='era5',\n        variable='tasmax',\n        time_frequency='day',\n        time=date,\n        host='nextgems.dkrz.de'\n    )\n    ds = xr.open_mfdataset(list(files), combine='by_coords', data_vars='all')\n    # ERA5 longitudes are stored on a 0–360° grid. Convert them to the\n    # conventional -180° to 180° range to simplify regional subsetting\n    ds = ds.assign_coords(lon=((ds.lon + 180) % 360) - 180).sortby('lon')\n    # Extract tasmax over Europe\n    tasmax_eur = ds['tasmax'].sel(lat=slice(35, 70), lon=slice(-25, 45))\n    # freva_client returns the full year's daily data. Select the requested date\n    tasmax_exact = tasmax_eur.sel(time=date)\n    \n    # Remove the singleton time dimension to obtain a 2D (lat, lon) field and\n    # store it in the list\n    tasmax_maps.append(tasmax_exact.squeeze())\n# Convert from K to °C\ntasmax_maps_C = [arr - 273.15 for arr in tasmax_maps]\n# Prepare coordinates for plotting\nlons = tasmax_maps_C[0]['lon'].values\nlats = tasmax_maps_C[0]['lat'].values\nlon2d, lat2d = np.meshgrid(lons, lats)\n# Plot\nfig, axs = plt.subplots(1, 5, figsize=(22, 5), \n                        subplot_kw={'projection': ccrs.PlateCarree()})\nvmin = min(float(arr.min()) for arr in tasmax_maps_C)\nvmax = max(float(arr.max()) for arr in tasmax_maps_C)\nlevels = np.linspace(vmin, vmax, 30)\n# 'RdYlBu_r' is a standard temperature colour map in climate science,\n# with blue indicating colder temperatures and red indicating warmer temperatures.\ncmap='RdYlBu_r'\nfor ax, data, date in zip(axs, tasmax_maps_C, dates):\n    cf = ax.contourf(lon2d, lat2d, data, \n                     levels=levels, extend='both', cmap=cmap, \n                     transform=ccrs.PlateCarree())\n        \n    ax.coastlines()\n    ax.add_feature(cfeature.BORDERS, linestyle=':')\n    ax.set_title(date)\n    \nfig.colorbar(cf, ax=axs, \n             orientation='horizontal', pad=0.05, \n             aspect=60, label='Max Temperature (°C)')\nplt.suptitle('Daily Maximum Temperature over Europe on June 27 (2022–2026)', y=0.72)\nplt.show()\"}"]}
