{"variant":"Code","content":["{\"code\":\"import freva_client\nimport xarray as xr\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nfrom sklearn.decomposition import PCA\n# Query ERA5 monthly sea level pressure.\n# The period begins in 1960 so that the first complete winter\n# (DJF 1961 = Dec 1960 + Jan–Feb 1961) is available.\nfiles = freva_client.databrowser(\n    project='reanalysis', experiment='era5', variable='psl',\n    time_frequency='mon',\n    time='1960-01-01to1990-12-31',\n    host='nextgems.dkrz.de'\n)\n# Load the dataset\ndset = xr.open_mfdataset(list(files),combine='by_coords',data_vars='all')\n# ERA5 longitudes are stored on a 0–360° grid. Convert them to the\n# conventional -180° to 180° range to simplify regional subsetting.\ndset = dset.assign_coords(lon=((dset.lon + 180) % 360) - 180).sortby('lon')\n# Extract sea level pressure over Europe\npsl_eur = dset['psl'].sel(\n    lat=slice(35, 70), lon=slice(-25, 45)\n)\n# Select winter months (December, January, February)\npsl_djf = psl_eur.where(\n    psl_eur.time.dt.month.isin([12, 1, 2]), \n                         drop=True\n)\n# Assign December to the following winter year\n# Example: Dec 1961, Jan 1962, Feb 1962 -> winter 1962\nwinter_year = xr.where(\n    psl_djf.time.dt.month == 12,\n    psl_djf.time.dt.year + 1,\n    psl_djf.time.dt.year)\npsl_djf = psl_djf.assign_coords(winter_year=winter_year)\n    \n# Compute DJF seasonal means\npsl_eur = psl_djf.groupby('winter_year').mean(dim='time')\n# Keep only complete winters\npsl_eur = psl_eur.sel(winter_year=slice(1961, 1990))\n# Remove the temporal mean to obtain anomalies\npsl_eur_anom = psl_eur - psl_eur.mean(dim='winter_year')\n# # Apply latitudinal weighting\nweights = np.sqrt(np.cos(np.deg2rad(psl_eur_anom.lat)))\npsl_weighted = psl_eur_anom * weights\n# Reshape into (years, grid cells) for PCA\nn_years, n_lat, n_lon = psl_weighted.shape\ndata_matrix = psl_weighted.values.reshape(n_years, n_lat * n_lon)\n# Perform PCA\npca = PCA(n_components=2)\npca.fit(data_matrix)\n# Extract the second EOF (second spatial loading pattern)\nsecond_eof_weighted = pca.components_[1].reshape(n_lat, n_lon)\n# Remove latitude weighting again for plotting\nsecond_eof = (\n    second_eof_weighted /\n    weights.values[:, np.newaxis]\n)\n# Prepare coordinates\nlon2d, lat2d = np.meshgrid(\n    psl_eur_anom['lon'].values,\n    psl_eur_anom['lat'].values\n)\n# Plot\nfig, ax = plt.subplots(figsize=(10, 6),\n                       subplot_kw={'projection': ccrs.PlateCarree()})\nvmax = np.abs(second_eof).max()\ncf = ax.contourf(\n    lon2d,\n    lat2d,\n    second_eof,\n    levels=np.linspace(-vmax, vmax, 31),\n    cmap='coolwarm',\n    transform=ccrs.PlateCarree()\n)\nax.coastlines()\nax.add_feature(cfeature.BORDERS, linestyle=':')\nplt.colorbar(cf, label='EOF Loading', orientation='horizontal', pad=0.05, \n             aspect=60)\nplt.title('Second EOF of DJF Mean Sea Level Pressure over Europe (1961–1990)')\nplt.show()\"}"]}
