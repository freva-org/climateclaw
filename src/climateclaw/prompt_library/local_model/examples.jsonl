{"variant":"Code", "content":["{\"code\":\"import freva_client\\nimport xarray as xr\\nimport numpy as np\\n\\n# 1. Query the ERA5 precipitation data for 2010 (monthly means)\\nfiles = freva_client.databrowser(\\n    project='reanalysis',\\n    experiment='era5',\\n    variable='pr',\\n    time_frequency='mon',\\n    time='2010-01-01to2010-12-31',\\n    host='nextgems.dkrz.de'\\n)\\n\\n# 2. Load the data\\npr_ds = xr.open_mfdataset(list(files), combine='by_coords')\\npr = pr_ds['pr']\\n\\n# 3. Calculate global mean for each month using area weighting\\nlat_rad = np.deg2rad(pr_ds['lat'])\\nweights = np.cos(lat_rad)\\nweights /= weights.sum()  # Normalize\\n# Broadcast weights for xarray\\nweighted_pr = pr.weighted(weights)\\nglobal_monthly_mean = weighted_pr.mean(dim=('lat', 'lon'))\\n\\n# 4. Compute the annual mean for 2010\\nglobal_annual_mean_2010 = global_monthly_mean.mean(dim='time')\\nfloat(global_annual_mean_2010.values)\"}","weight_by_area"]}
