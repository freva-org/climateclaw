{"variant":"Code","content":["{\"code\":\"# Step 2: Compute annual means\\nhurs_ann = hurs['hurs'].groupby('time.year').mean(dim='time')\\npr_ann = pr['pr'].groupby('time.year').mean(dim='time')\\n\\n# Step 3: Latitude weights (cosine of latitude)\\nlats = hurs_ann['lat'].values\\nlat_weights = np.cos(np.deg2rad(lats))\\nlat_weights_2d = np.repeat(lat_weights[:, None], hurs_ann['lon'].size, axis=1)\\n\\n# Step 4: Weighted spatial correlation per year\\nyears = hurs_ann['year'].values\\ncorrs_w = []\\nfor i, year in enumerate(years):\\n    h = hurs_ann.isel(year=i).values\\n    p = pr_ann.isel(year=i).values\\n    mask = np.isfinite(h) & np.isfinite(p)\\n    if mask.sum() > 2:\\n        hw = h[mask]\\n        pw = p[mask]\\n        ww = lat_weights_2d[mask]\\n        hw_cent = hw - np.average(hw, weights=ww)\\n        pw_cent = pw - np.average(pw, weights=ww)\\n        weighted_cov = np.average(hw_cent * pw_cent, weights=ww)\\n        weighted_std_h = np.sqrt(np.average(hw_cent**2, weights=ww))\\n        weighted_std_p = np.sqrt(np.average(pw_cent**2, weights=ww))\\n        wr = weighted_cov / (weighted_std_h * weighted_std_p)\\n    else:\\n        wr = np.nan\\n    corrs_w.append(wr)\\n\\n# Step 5: Plot the area-weighted correlation\\nyears = list(years)\\nplt.figure(figsize=(12,6))\\nplt.plot(years, corrs_w, label='Area-weighted Corr(hurs, pr)')\\nplt.xlabel('Year')\\nplt.ylabel('Area-weighted Spatial Correlation')\\nplt.title('ERA5: Area-weighted Annual Spatial Correlation of hurs vs pr (1940–2024)')\\nplt.grid(True)\\nplt.legend()\\nplt.tight_layout()\\nplt.show()\"}","call_pSX0EGsEgbITGGnquBoBwlLo"]}
